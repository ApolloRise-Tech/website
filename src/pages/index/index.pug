    //-Google Tag Manager (noscript) -->
    iframe(src="https://www.googletagmanager.com/ns.html?id=GTM-PXHCM38Q" height="0" width="0" style="display:none;visibility:hidden")
    //-  End Google Tag Manager (noscript)

    include ../../components/header/header
    +header({ linksHeader: linksHeader, contactUs: '#contactUs' })
    main 
      include ../../components/main/main 
      include ../../components/about/about
      include ../../components/whatWeDo/whatWeDo
      include ../../components/industries/industries

      section(data-color="white" id="ourWork").cases.wrapper.colorSection 
        .cases__wrapper
          h2.h1._anim-items._anim-no-hide Our work
          .cases__casesList
            each card in caseRecommendationsList
              include ../../components/caseRecommendationCard/caseRecommendationCard
              +caseRecommendationCard({ card: card })
          a.portfolioLink._anim-items._anim-no-hide(href="portfolio.html")
            span View all 11 projects
            svg(xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none")
              path(d="M5 12H19" stroke="#23221F" stroke-width="1.5")
              path(d="M13 6L19 12L13 18" stroke="#23221F" stroke-width="1.5")

      include ../../components/howWeWork/howWeWork
      include ../../components/ourCoreValues/ourCoreValues
      include ../../components/contactUs/contactUs
    include ../../components/footer/footer
    +footer({ linksFooter: linksFooter, contactUs: '#contactUs' })
