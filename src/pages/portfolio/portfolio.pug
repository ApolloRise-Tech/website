  body
    iframe(src="https://www.googletagmanager.com/ns.html?id=GTM-PXHCM38Q" height="0" width="0" style="display:none;visibility:hidden")

    include ../../components/header/header
    +header({ linksHeader: linksHeader, contactUs: '/#contactUs' })

    main

      //- HERO — yellowLight background, full height
      section(data-color="white").portfolioHero.colorSection
        .portfolioHero__wrapper
          h6.subtitle.portfolioHero__subtitle._anim-items._anim-no-hide Our Work
          h1.h1.portfolioHero__title._anim-items._anim-no-hide We are proud of every single project we've built.
          p.text_1.portfolioHero__description._anim-items._anim-no-hide 11 shipped products. From aggressive MVPs to enterprise AI platforms. Each one a story of grit, late nights, and genuine partnership.

      //- PORTFOLIO GRID — reuses the exact same .cases CSS from the main page
      section(data-color="white" id="ourWork").cases.wrapper.colorSection
        .cases__wrapper
          .cases__casesList
            each project in projects
              include ../../components/caseRecommendationCard/caseRecommendationCard
              +caseRecommendationCard({ card: project })

      //- CTA — invite to connect
      section(data-color="dark").portfolioCta.colorSection
        .portfolioCta__inner
          h6.subtitle.portfolioCta__label._anim-items._anim-no-hide Want to be next?
          h2.h2.portfolioCta__title._anim-items._anim-no-hide Let's build something we'll both be proud of.
          a(href="/#contactUs").button_yellow.size_m.portfolioCta__button._anim-items._anim-no-hide
            p Start the Conversation

    include ../../components/footer/footer
    +footer({ linksFooter: linksFooter, contactUs: '/#contactUs' })
