html
  head 
    meta(charset="UTF-8")
    meta(name="viewport" content="width=device-width, initial-scale=1") 
    meta(name="apple-mobile-web-app-capable" content="yes")
    meta(name="mobile-web-app-capable" content="yes")

    <!-- Status bar styles -->
    meta(name="apple-mobile-web-app-status-bar-style" content="black-translucent")
    meta(name="theme-color" content="#FCFBF8")

    <!-- Title -->
    title Careers | ApolloRise Tech — Join the Team
    meta(name="description" content="Join ApolloRise Tech — a boutique AI engineering firm building complex digital products. We're always open to exceptional engineers, designers, and product thinkers.")
    meta(name="keywords" content="ApolloRise careers, AI engineering jobs, software engineer remote, boutique tech company, join tech team")
    meta(name="author" content="Yurii Kapkov")

    <!-- Canonical -->
    link(rel="canonical" href="https://apollorise.tech/career")

    <!-- Open Graph -->
    meta(property="og:type" content="website")
    meta(property="og:title" content="Careers | ApolloRise Tech — Join the Team")
    meta(property="og:description" content="Join ApolloRise Tech — a boutique AI engineering firm building complex digital products. We're always open to exceptional engineers, designers, and product thinkers.")
    meta(property="og:url" content="https://apollorise.tech/career")
    meta(property="og:image" content="https://apollorise.tech/sources/images/linkImage.png")
    meta(property="og:image:width" content="1200")
    meta(property="og:image:height" content="630")
    meta(property="og:site_name" content="ApolloRise Tech")

    <!-- Twitter / X -->
    meta(name="twitter:card" content="summary_large_image")
    meta(name="twitter:title" content="Careers | ApolloRise Tech — Join the Team")
    meta(name="twitter:description" content="Join ApolloRise Tech — a boutique AI engineering firm building complex digital products.")
    meta(name="twitter:image" content="https://apollorise.tech/sources/images/linkImage.png")
    meta(name="twitter:site" content="@apollorisetech")

    link(rel='stylesheet', href='../../sources/fonts/fonts.css')

    <!-- Favicons -->
    link(rel="icon" type="image/png" href=require('../../sources/images/favicon.png'))
    link(rel="shortcut icon" href=require('../../sources/images/favicon.ico'))

    link(rel="apple-touch-icon" sizes="76x76" href=require('../../sources/images/apple-touch-icon-76x76.png'))
    link(rel="apple-touch-icon" sizes="120x120" href=require('../../sources/images/apple-touch-icon-120x120.png'))
    link(rel="apple-touch-icon" sizes="152x152" href=require('../../sources/images/apple-touch-icon-152x152.png'))
    link(rel="apple-touch-icon" sizes="180x180" href=require('../../sources/images/apple-touch-icon-180x180.png'))

