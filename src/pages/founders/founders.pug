html
  head 
    meta(charset="UTF-8")
    meta(name="viewport" content="width=device-width, initial-scale=1") 
    meta(name="apple-mobile-web-app-capable" content="yes")
    meta(name="mobile-web-app-capable" content="yes")
    meta(name="apple-mobile-web-app-status-bar-style" content="black-translucent")
    meta(name="theme-color" content="#FCFBF8")

    title Founders | ApolloRise Tech — Yurii & Irina
    meta(name="description" content="Meet Yurii and Irina — the two founders of ApolloRise Tech. Two builders shaped by war, hardship, and an unbreakable belief in authentic tech partnerships.")
    meta(name="author" content="Yurii Kapkov")

    meta(property="og:type" content="website")
    meta(property="og:title" content="Founders | ApolloRise Tech")
    meta(property="og:description" content="Meet the faces behind ApolloRise — Yurii & Irina.")
    meta(property="og:url" content="https://apollorise.tech/founders")
    meta(property="og:image" content="https://apollorise.tech/sources/images/picture.png")
    meta(property="og:site_name" content="apollorise.tech")

    link(rel='stylesheet', href='../../sources/fonts/fonts.css')

    link(rel="icon" type="image/png" href=require('../../sources/images/favicon.png'))
    link(rel="shortcut icon" href=require('../../sources/images/favicon.ico'))
    link(rel="apple-touch-icon" sizes="76x76" href=require('../../sources/images/apple-touch-icon-76x76.png'))
    link(rel="apple-touch-icon" sizes="120x120" href=require('../../sources/images/apple-touch-icon-120x120.png'))
    link(rel="apple-touch-icon" sizes="152x152" href=require('../../sources/images/apple-touch-icon-152x152.png'))
    link(rel="apple-touch-icon" sizes="180x180" href=require('../../sources/images/apple-touch-icon-180x180.png'))

