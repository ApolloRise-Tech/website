  const pageContent = [
    {
      contentType: 'withoutTitle',
      content: [{
        name: 'Services',
        text: `<ul>
          <li class="h4">Full-cycle product development</li>
          <li class="h4">AI / OCR integration</li> 
          <li class="h4">Product design</li> 
          <li class="h4">Cloud infrastructure</li>
        </ul>`
        },
        {
          name: 'Industries',
          text: `<div class="h4">FinTech, Accounting, B2B SaaS</div>`
        }
      ],
    },
    {
      title: 'About',
      contentType: 'text',
      content: [{
        type: 'text',
        text: 'Parseon is an enterprise SaaS platform that automates data extraction from PDF documents — invoices, contracts, receipts — using AI-powered OCR. It replaces hours of manual data entry with structured, exportable results in seconds.'
      }],
    },
    {
      title: 'The Problem',
      contentType: 'text',
      content: [
        {
          type: 'text',
          text: `Finance teams and accountants spend countless hours manually typing data from invoices and receipts into spreadsheets. With hundreds of documents arriving weekly — each in a different format, layout, and quality — the process is slow, error-prone, and expensive.`
        },
        {
          type: 'text',
          text: `Existing OCR tools either lack accuracy on real-world scanned documents or require heavy manual correction. Companies needed a solution that could handle messy PDFs, extract exactly the fields they need, and export clean data ready for their accounting systems.`
        }
      ],
    },
    {
      title: 'Our Solution',
      contentType: 'text',
      content: [
        {
          type: 'text',
          text: `We built Parseon from the ground up — a full-stack SaaS platform where users upload PDFs, define custom extraction templates, and get structured data back automatically. The AI handles the rest: OCR, field recognition, data normalization, and Excel export.`
        },
        {
          type: 'text',
          text: `For low-quality scanned documents, we developed a dedicated Python microservice that pre-processes PDFs — correcting rotation, removing noise, and enhancing readability — before sending them to the AI engine. This dramatically improves extraction accuracy on real-world documents.`
        }
      ],
    },
    {
      title: 'Team',
      contentType: 'tag',
      content: [
        {
          icons: [
            require('../../../sources/images/thumbnail_1.png')
          ],
          position: 'Product Designer'
        },
        {
          icons: [
            require('../../../sources/images/thumbnail_2.png')
          ],
          position: 'Backend Developer'
        },
        {
          icons: [
            require('../../../sources/images/thumbnail_4.png')
          ],
          position: 'Frontend Developer'
        },
        {
          icons: [
            require('../../../sources/images/thumbnail_7.png')
          ],
          position: 'DevOps Engineer'
        },
        {
          icons: [
            require('../../../sources/images/thumbnail_8.png')
          ],
          position: 'Project Manager'
        },
      ]
    },
    {
      title: 'Project workflow',
      contentType: 'list',
      content: [
        {
          itemTitle: `Research & Architecture Design <span>(2 weeks)</span>`,
          itemDescription: `Analyzed the document processing market, defined the core extraction pipeline, and designed the system architecture — from PDF upload to structured Excel output.`
        },
        {
          itemTitle: `PDF Pre-Processing Microservice <span>(2 weeks)</span>`,
          itemDescription: `Built a Python FastAPI service for scanned document enhancement: deskewing, noise removal, rotation correction, and grayscale optimization. This step was critical for real-world document quality.`
        },
        {
          itemTitle: `Core Platform Development <span>(2 months)</span>`,
          itemDescription: `Developed the full Laravel + React application: multi-tenant organizations, folder management, document upload to S3, and the OCR → Extract pipeline with async queue processing.`
        },
        {
          itemTitle: `Custom Template Engine <span>(3 weeks)</span>`,
          itemDescription: `Built a flexible template system allowing users to define exactly which fields to extract — with support for nested objects, arrays, table columns, and AI system prompts for context-specific extraction.`
        },
        {
          itemTitle: `Smart Page Range Processing <span>(2 weeks)</span>`,
          itemDescription: `Implemented intelligent document splitting for large PDFs (25+ pages) — automatic range detection, parallel processing of chunks, and result merging for accurate extraction at scale.`
        },
        {
          itemTitle: `Excel Export & Reporting <span>(1 week)</span>`,
          itemDescription: `Created styled Excel exports with color-coded headers, confidence highlighting, and per-folder batch export — ready to drop into any accounting system.`
        },
        {
          itemTitle: `Infrastructure & Deployment <span>(1 week)</span>`,
          itemDescription: `Containerized the entire stack with Docker Compose (app, Redis, PDF processor), configured Nginx, Supervisor, and Laravel Horizon for production-grade queue management.`
        },
      ]
    },
    {
      contentType: 'title', 
      content: 'Key Features',
    },
    {
      title: 'AI-Powered Document Extraction',
      contentType: 'text',
      content: [
        {
          type: 'text',
          text: `The core of Parseon is the OCR → Extract pipeline. Documents are first parsed with AI-powered OCR to extract raw text, then processed through a structured extraction engine that maps the content to user-defined field schemas.`
        },
        {
          type: 'text',
          text: `The system handles invoices, contracts, receipts, and any custom document type. Each extraction returns confidence scores so users can instantly see which fields need manual review and which are ready to export.`
        },
      ],
    },
    {
      title: 'Custom Extraction Templates',
      contentType: 'text',
      content: [
        {
          type: 'text',
          text: `Users define templates that tell the AI exactly what to extract. Templates support field types (string, number, array, object), nested hierarchies for complex documents, and table column detection for line items.`
        },
        {
          type: 'text',
          text: `Each template can include a system prompt — up to 2,000 characters of natural language instructions that guide the AI's behavior. This means the same platform can handle a one-page receipt and a 50-page government contract with equal precision.`
        },
      ],
    },
    {
      title: 'PDF Pre-Processing Engine',
      contentType: 'text',
      content: [
        {
          type: 'text',
          text: `Real-world scanned documents are often rotated, noisy, or low-contrast. Our dedicated Python microservice fixes these issues before the AI even sees the document — deskewing pages using multiple detection algorithms (Hough transform, baseline analysis, projection profiling), removing speckle noise, and optimizing contrast.`
        },
        {
          type: 'text',
          text: `This pre-processing step improved extraction accuracy by 15–25% on scanned documents compared to sending raw PDFs directly to the AI.`
        },
      ],
    },
    {
      title: 'Smart Large Document Handling',
      contentType: 'text',
      content: [
        {
          type: 'text',
          text: `Documents over 25 pages are automatically split into optimally-sized chunks, processed in parallel across multiple queue workers, and then intelligently merged back into a single structured result. Users can also manually define page ranges for precise control over multi-section documents.`
        },
      ],
    },
    {
      title: 'Organization & Folder Management',
      contentType: 'text',
      content: [
        {
          type: 'text',
          text: `Parseon is built for teams. Multi-tenant organizations can manage users, while the folder system (organized by company/vendor/project) keeps documents structured. Each folder shows real-time processing stats — total documents, processed, pending, and failed — giving operations managers full visibility.`
        },
      ],
    },
    {
      title: 'Excel Export',
      contentType: 'text',
      content: [
        {
          type: 'text',
          text: `One-click export turns extracted data into production-ready Excel reports. Exports include styled headers, color-coded confidence indicators, and support for both single-document and batch folder exports. The output is designed to drop directly into accounting and ERP systems with zero reformatting.`
        },
      ],
    },
    {
      title: 'Results',
      contentType: 'text',
      content: [
        {
          type: 'text',
          text: `Parseon processes documents in under 60 seconds — replacing what used to take 15–30 minutes of manual data entry per invoice. The platform handles documents up to 50 MB with OCR confidence scoring that eliminates guesswork.`
        },
        {
          type: 'text',
          text: `Built as ApolloRise's own product, Parseon demonstrates our ability to take a complex AI/OCR challenge from zero to production SaaS — including architecture, AI pipeline, PDF processing, cloud infrastructure, and a polished user experience.`
        }
      ],
    },
    {
      title: 'Tech Stack',
      contentType: 'text',
      content: [
        {
          type: 'text',
          text: `Laravel 12, React 19, TypeScript, Inertia.js, Tailwind CSS, Python, FastAPI, Redis, MySQL, AWS S3, Docker, Nginx, Laravel Horizon`
        }
      ],
    },
  ]

