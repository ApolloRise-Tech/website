-
  const cards = [
    {
      number: '01',
      title: 'Complex Digital Products',
      description: 'From ambitious MVPs to full-scale enterprise platforms — we architect, design, and build software that solves real business problems and scales.',
    },
    {
      number: '02',
      title: 'Agentic AI & LLM Integrations',
      description: 'We build production-grade AI systems: agentic OCR, GenAI analytics, intelligent automation and custom MCP tools that give your product a real edge.',
    },
    {
      number: '03',
      title: 'Technical Partnership',
      description: 'We act as your fractional CTO and core engineering team. We invest ourselves fully into your product roadmap, hiring, and technical strategy.',
    },
    {
      number: '04',
      title: 'PoCs & Rapid Prototyping',
      description: 'Have high-stakes idea to validate? We rapidly build Proof of Concepts for US startups & enterprises — no bureaucracy, just fast, focused results.',
    },
    {
      number: '05',
      title: 'Long-Term Support & Growth',
      description: 'We don\'t disappear after launch. We are human-first: we stay with you, care about your metrics, and grow with you year after year.',
    },
  ]

section(data-color="dark" id="whatWeDo").whatWeDo.colorSection
  .whatWeDo__wrapper 
    h2.h1.whatWeDo__title._anim-items._anim-no-hide How we can help you
    each card in cards
      .whatWeDo__container._anim-items._anim-no-hide
        .whatWeDo__card
          h3.h3= card.title
          p.text_4.whatWeDo__card_description= card.description
          .whatWeDo__card_number= card.number
