- 
  const cards = [
    {
      name: 'Agentic AI', 
    },
    {
      name: 'Complex Digital Products', 
    },
    {
      name: 'HealthTech', 
    },
    {
      name: 'Startup Co-Founder',
    },
    {
      name: 'PoC & MVPs',
    }
  ]

section(data-color="white").main.colorSection
  .main__container
    .main__wrapper._anim-items._anim-no-hide 
      h1.h1.main__title._anim-items._anim-no-hide 
        | Engineering with a Soul.
        br
        | We Build What Matters.
      button.button_black.size_m.main__button._anim-items._anim-no-hide(id="main__button")
        p Let's Build Together
    .main__cards._anim-items._anim-no-hide 
      each card in cards
        .main__card._anim-items._anim-no-hide 
          h4.h4= card.name

