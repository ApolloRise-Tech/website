-
 const swiperCards = [
  {
    title: 'Grit & Resilience',
    description: 'Our founders have overcome real-world adversity and global crises to build this. We apply the same relentless resolve to every project.',
  },
  {
    title: 'Radical Authenticity',
    description: 'No LinkedIn fluff. Real people, real story, real relationships with every partner.',
  },
  {
    title: 'Proven Track Record',
    description: '5+ own products (1000+ active users), 10+ PoCs for US companies, 3 years of trusted partnerships.',
  },
  {
    title: 'Human-First Philosophy',
    description: 'Clients from day one stay with us for years. We mentor our community and run free AI education.',
  },
  {
    title: 'Rooted in Orlando',
    description: 'We have a strong local presence with deep tech partnerships. Active leaders in Women in Tech & Entrepreneurs and the broader Central Florida innovation ecosystem.',
  },
 ]

section(data-color="white").ourCoreValues.colorSection
  .ourCoreValues__header
    h1.ourCoreValues__title._anim-items._anim-no-hide Why choose
    h6.text_1.ourCoreValues__description._anim-items._anim-no-hide
     | ApolloRise?
     span  We are not just a vendor — we are the team that fights for your project
     |  until you win. Partners who stay, builders who care.
  .ourCoreValues__swiper
    .ourCoreValues__buttons._anim-items._anim-no-hide
      .swiper-button-prev.ourCoreValues-button-prev
        <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none">
          <g clip-path="url(#clip0_1_2308)">
            <path d="M20.25 12H3.75" stroke="#23221F" stroke-width="1.5"/>
            <path d="M10.5 5.25L3.75 12L10.5 18.75" stroke="#23221F" stroke-width="1.5"/>
          </g>
          <defs>
            <clipPath id="clip0_1_2308">
              <rect width="24" height="24" fill="white"/>
            </clipPath>
          </defs>
        </svg>
      .swiper-button-next.ourCoreValues-button-next
        <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none">
          <g clip-path="url(#clip0_1_2514)">
            <path d="M3.75 12H20.25" stroke="#23221F" stroke-width="1.5"/>
            <path d="M13.5 5.25L20.25 12L13.5 18.75" stroke="#23221F" stroke-width="1.5"/>
