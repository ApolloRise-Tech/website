          <defs>
            <clipPath id="clip0_1_2514">
              <rect width="24" height="24" fill="white"/>
            </clipPath>
          </defs>
        </svg>
    .swiper-wrapper
      each swiperCard in swiperCards
        .swiper-slide._anim-items._anim-no-hide
          .ourCoreValues__card
            h3.h3= swiperCard.title
            p.text_4= swiperCard.description
    .ourCoreValues__navigation
      .swiper-button-prev.ourCoreValues-button-prev
