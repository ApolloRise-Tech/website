mixin ourProducts()
  section.ourProducts.wrapper.colorSection(data-color="dark")
    .ourProducts__inner
      .ourProducts__header
        h6.subtitle.ourProducts__subtitle._anim-items._anim-no-hide Our Products
        h2.h1.ourProducts__title._anim-items._anim-no-hide We don't just build for clients — we build and run our own.

      .ourProducts__grid
        a.ourProducts__card._anim-items._anim-no-hide(href="https://docsdna.ai" target="_blank" rel="noopener noreferrer")
          h3.h2.ourProducts__card-name DocsDNA
          p.text_1.ourProducts__card-desc Agentic AI platform for contract analysis and document review. Turns hours of manual work into minutes.
          .ourProducts__card-link
            span docsdna.ai
            svg(xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none")
              path(d="M7 17L17 7" stroke="currentColor" stroke-width="1.5" stroke-linecap="round")
              path(d="M7 7H17V17" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round")

        a.ourProducts__card._anim-items._anim-no-hide(href="https://parseon.apollorise.tech" target="_blank" rel="noopener noreferrer")
          h3.h2.ourProducts__card-name Parseon
          p.text_1.ourProducts__card-desc AI-powered OCR that extracts structured data from any invoice or document. Upload a PDF — get Excel in seconds.
          .ourProducts__card-link
            span parseon.apollorise.tech
            svg(xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none")
              path(d="M7 17L17 7" stroke="currentColor" stroke-width="1.5" stroke-linecap="round")
              path(d="M7 7H17V17" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round")

        a.ourProducts__card._anim-items._anim-no-hide(href="https://pulsar.apollorise.tech" target="_blank" rel="noopener noreferrer")
          h3.h2.ourProducts__card-name Pulsar
          p.text_1.ourProducts__card-desc Procurement optimization powered by AI. Semantic search across 500K products — instant savings reports, every order.
          .ourProducts__card-link
            span pulsar.apollorise.tech
            svg(xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none")
              path(d="M7 17L17 7" stroke="currentColor" stroke-width="1.5" stroke-linecap="round")
              path(d="M7 7H17V17" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round")
