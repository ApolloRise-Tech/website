-
  const workCards = [
    {
      number: '1',
      title: 'Real Discovery Call', 
      description: 'No pre-sales. We get on a call, listen deeply to your business, your goals, and your constraints. We ask the hard questions others are afraid to ask.'
    },
    {
      number: '2',
      title: 'Honest Scope & Strategy', 
      description: 'We define what to build, how, and in what order — based on business value, not just engineering preference. Clear budget, timelines, and milestones.'
    },
    {
      number: '3',
      title: 'Design & Build', 
      description: 'Our senior engineers and designers get to work. We build iteratively with your constant involvement. No surprises. You see progress every week.'
    },
    {
      number: '4',
      title: 'Quality & Reliability', 
      description: 'We don\'t skip testing. Every feature is stress-tested, edge cases covered. We care about stability because it\'s our reputation on the line too.'
    },
    {
      number: '5',
      title: 'Launch & Scale', 
      description: 'We deploy, monitor, and ensure a smooth go-live. We don\'t disappear after launch — we help you grow and iterate on what\'s working.'
    },
    {
      number: '6',
      title: 'Long-Term Partnership', 
      description: 'Most of our clients have worked with us for years. We become part of your extended team — reliable, adaptive, and deeply invested in your success.'
    },
  ]

section(data-color="white" id="howWeWork").howWeWork.colorSection
  h1.h1.howWeWork__title._anim-items._anim-no-hide How we work
  each workCard in workCards
    .howWeWork__card
      .howWeWork__card_number
        span.text_3= workCard.number
      h3.h2.howWeWork__card_title= workCard.title
      p.howWeWork__card_description= workCard.description
  
  .howWeWork__cards_swiper
    .swiper-wrapper
      each workCard in workCards
        .swiper-slide._anim-items._anim-no-hide
          .howWeWork__card
            .howWeWork__card_number
              span.text_3= workCard.number
            h3.h2.howWeWork__card_title= workCard.title
            p.howWeWork__card_description= workCard.description
    .howWeWork__cards_navigation
      .swiper-button-prev.howWeWork-button-prev
        <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none">
          <g clip-path="url(#clip0_1_3106)">
            <path d="M20.25 12H3.75" stroke="#23221F" stroke-width="1.5"/>
            <path d="M10.5 5.25L3.75 12L10.5 18.75" stroke="#23221F" stroke-width="1.5"/>
          </g>
          <defs>
            <clipPath id="clip0_1_3106">
              <rect width="24" height="24" fill="white"/>
            </clipPath>
          </defs>
        </svg>
      .swiper-pagination.howWeWork-pagination
      .swiper-button-next.howWeWork-button-next
        <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none">
          <g clip-path="url(#clip0_1_3118)">
            <path d="M3.75 12H20.25" stroke="#23221F" stroke-width="1.5"/>
            <path d="M13.5 5.25L20.25 12L13.5 18.75" stroke="#23221F" stroke-width="1.5"/>
          </g>
          <defs>
            <clipPath id="clip0_1_3118">
              <rect width="24" height="24" fill="white"/>
            </clipPath>
          </defs>
        </svg>
      
